# Server Configuration
PORT=3000
FRONTEND_URL=http://localhost:5173

# PostgreSQL Database
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=dam
DB_USER=postgres
DB_PASSWORD=change_me_postgres_password
DB_POOL_MAX=20

# Redis Cache & Rate Limiting
REDIS_URL=redis://127.0.0.1:6379

# RabbitMQ Message Broker
RABBITMQ_URL=amqp://admin:change_me_rabbitmq_password@127.0.0.1:5672

# MinIO Object Storage
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=admin
MINIO_SECRET_KEY=change_me_minio_password
MINIO_BUCKET=dam-assets

# Authentication & Security (Use a strong random 32+ char string for JWT_SECRET)
JWT_SECRET=replace_with_a_strong_random_jwt_secret_key

# Initial Admin Seed User
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change_me_admin_password

# Internal Worker Authentication
WORKER_API_TOKEN=replace_with_a_strong_random_worker_token
